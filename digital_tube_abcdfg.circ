  <vhdl appearance="logisim_evolution" name="digital_tube">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
entity digital_tube is&#13;
    port(&#13;
        en      :in std_logic;&#13;
        dat     :in std_logic_vector(3 downto 0);&#13;
        display :out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity digital_tube;&#13;
&#13;
architecture bhv of digital_tube is&#13;
begin&#13;
    process(en,dat)&#13;
    begin&#13;
        if en='0' then&#13;
            display &lt;= "ZZZZZZZZ";&#13;
          else&#13;
            case dat is&#13;
                when "0000" =&gt; display &lt;= "11101110";&#13;
                when "0001" =&gt; display &lt;= "00111110";&#13;
                when "0010" =&gt; display &lt;= "10011100";&#13;
                when "0011" =&gt; display &lt;= "01111010";&#13;
                when "0100" =&gt; display &lt;= "10001110";&#13;
                when "0101" =&gt; display &lt;= "11110110";&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
