  <vhdl appearance="logisim_evolution" name="digital_tube_vt">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
entity digital_tube_vt is&#13;
    port(&#13;
        en      :in std_logic;&#13;
        vt      :in std_logic_vector(13 downto 1);&#13;
        display :out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity digital_tube_vt;&#13;
&#13;
architecture bhv of digital_tube_vt is&#13;
begin&#13;
    process(en,vt)&#13;
    variable sum:integer range 0 to 13;&#13;
    begin&#13;
        sum:= 0;&#13;
        for i in 1 to 13 loop&#13;
            if (vt(i)='1') then&#13;
                sum:= sum + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if en='0' then&#13;
            display &lt;= "ZZZZZZZZ";&#13;
          else&#13;
            case sum is&#13;
                when 0 =&gt; display &lt;= "11111100";
                when 1 =&gt; display &lt;= "01100000";&#13;
                when 2 =&gt; display &lt;= "11011010";&#13;
                when 3 =&gt; display &lt;= "11110010";&#13;
                when 4 =&gt; display &lt;= "01100110";&#13;
                when 5 =&gt; display &lt;= "10110110";&#13;
                when 6 =&gt; display &lt;= "10111110";&#13;
                when 7 =&gt; display &lt;= "11100000";&#13;
                when 8 =&gt; display &lt;= "11111110";&#13;
                when 9 =&gt; display &lt;= "11100110";&#13;
                when 10 =&gt; display &lt;= "11101110";
                when 11 =&gt; display &lt;= "00111110";&#13;
                when 12 =&gt; display &lt;= "10011100";&#13;
                when 13 =&gt; display &lt;= "01111010";&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
